# ================================
# VyapaarFlow — Complete .gitignore
# ================================

# --- Dependencies ---
node_modules/
jspm_packages/

# --- Environment & Secrets (NEVER commit these) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# --- Build Artifacts ---
dist/
build/
out/
.next/
.cache/
*.tsbuildinfo

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Test Coverage ---
coverage/
.nyc_output/

# --- macOS System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- IDEs & Editors ---
.vscode/
.idea/
*.swp
*.swo
.project
.settings/

# --- Prisma ---
# Don't ignore the schema but do ignore generated migration state if using CI
# backend/prisma/migrations/ (uncomment if you want clean migrations in CI)

# --- Debug & Scratch Files ---
backend/scratch_debug.js
backend/backend/

# --- Cache ---
.eslintcache
.stylelintcache
*.local
