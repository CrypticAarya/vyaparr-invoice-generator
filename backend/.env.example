# VyaparFlow Backend Environment Template
# Copy this to .env and fill in the values

NODE_ENV=production
PORT=5001

# Relational Database (Neon PostgreSQL)
# Neon pooling optimization: ?sslmode=require&pgbouncer=true
DATABASE_URL=

# Security (Generate strong keys for production)
JWT_SECRET=
JWT_REFRESH_SECRET=

# AI Integrations (OpenAI)
OPENAI_API_KEY=

# CORS & Communication
# The URL of your deployed frontend (e.g., https://vyaparflow.vercel.app)
FRONTEND_URL=
