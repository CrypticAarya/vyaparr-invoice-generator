# Production Environment Variables Example
NODE_ENV=production
PORT=5000

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vyaparflow?retryWrites=true&w=majority

# Security
JWT_SECRET=your_32_character_long_secure_secret
REFRESH_SECRET=another_long_secure_secret_for_refresh_tokens

# AI Integrations
OPENAI_API_KEY=sk-xxxx

# CORS & Communication
FRONTEND_URL=https://vyaparflow.vercel.app
